{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mathrender",
	"account_id": "d6fb86ee73f8cf54072fb06627cd0413",
	"main": "cloudflare/worker.mjs",
	"compatibility_date": "2026-10-01",
	"keep_vars": true,
	"triggers": {
		"crons": [
			"17 * * * *"
		]
	},
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/classroom/*"
		]
	},
	"r2_buckets": [
		{
			"binding": "CLASSROOM_PHOTOS",
			"bucket_name": "mathrender-classroom-photos"
		}
	],
	"d1_databases": [
		{
			"binding": "CLASSROOM_DB",
			"migrations_dir": "cloudflare/migrations",
			"database_name": "mathrender-classroom",
			"database_id": "a7ea8353-516d-4563-b44e-cf4620871e93"
		}
	]
}
